  "components": [
    {
      "name": "Sound-Kachel",
      "kind": "card",
      "refersTo": "sound-tile",
      "description": "Kissen-Kachel im Ruhezustand: Icon-Rondell in Minz-Tönung, Label darunter.",
      "html": "<button class=\"ds-tile\"><span class=\"ds-tile-icon\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242\"/><path d=\"M16 14v6\"/><path d=\"M8 14v6\"/><path d=\"M12 16v6\"/></svg></span><span class=\"ds-tile-label\">Sanfter Regen</span></button>",
      "css": ".ds-tile{display:flex;flex-direction:column;align-items:center;width:132px;padding:16px 8px 14px;border:0;border-radius:16px;background:var(--surface, #fff);box-shadow:0 10px 22px -12px var(--shadow, rgba(34,43,69,.14));cursor:pointer;font-family:Cairo,system-ui,sans-serif;transition:transform .2s} .ds-tile:hover{transform:translateY(-2px)} .ds-tile:focus-visible{outline:2px solid var(--accent, #2c7d59);outline-offset:2px} .ds-tile-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9999px;background:var(--accent-soft, #d8f0e3);color:var(--accent, #2c7d59)} .ds-tile-label{margin-top:8px;min-height:2.4em;font-size:12px;font-weight:700;line-height:1.35;color:var(--text, #222b45)"
    },
    {
      "name": "Sound-Kachel (aktiv)",
      "kind": "card",
      "refersTo": "sound-tile-active",
      "description": "Aktiv: Fläche wird Salbeiminze, Rondell abgedunkelt, Regler und natürlich-Pille erscheinen.",
      "html": "<div class=\"ds-tile-on\"><span class=\"ds-on-icon\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242\"/><path d=\"M16 14v6\"/><path d=\"M8 14v6\"/><path d=\"M12 16v6\"/></svg></span><span class=\"ds-on-label\">Sanfter Regen</span><span class=\"ds-on-slider\"><i></i></span><span class=\"ds-on-pill\">natürlich</span></div>",
      "css": ".ds-tile-on{display:flex;flex-direction:column;align-items:center;width:132px;padding:16px 8px 14px;border-radius:16px;background:var(--accent, #2c7d59);box-shadow:0 12px 26px -10px var(--shadow, rgba(34,43,69,.14));font-family:Cairo,system-ui,sans-serif} .ds-on-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9999px;background:var(--veil, rgba(34,43,69,.16));color:var(--accent-ink, #fff)} .ds-on-label{margin-top:8px;font-size:12px;font-weight:700;color:var(--accent-ink, #fff)} .ds-on-slider{display:block;width:96px;height:4px;margin-top:10px;border-radius:9999px;background:var(--veil, rgba(34,43,69,.16));position:relative} .ds-on-slider i{position:absolute;left:0;top:0;height:4px;width:65%;border-radius:9999px;background:'+V('accent-ink','#fff')+'} .ds-on-pill{margin-top:10px;padding:4px 10px;border-radius:9999px;background:var(--veil, rgba(34,43,69,.16));font-size:12px;font-weight:700;color:var(--accent-ink, #fff)"
    },
    {
      "name": "Track-Karte",
      "kind": "card",
      "refersTo": "track-card",
      "description": "Meditation/Atemübung: Rondell mit Tag, Titel, Dauer, Play-Kreis.",
      "html": "<button class=\"ds-track\"><span class=\"ds-track-top\"><span class=\"ds-track-icon\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/></svg></span><span class=\"ds-track-tag\">ACHTSAMKEIT</span></span><span class=\"ds-track-title\">Guided Meditation (10 Min)</span><span class=\"ds-track-bottom\"><span class=\"ds-track-dur\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>10:00</span><span class=\"ds-track-play\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg></span></span></button>",
      "css": ".ds-track{display:flex;flex-direction:column;gap:14px;width:240px;padding:16px;border:0;border-radius:16px;text-align:left;background:var(--surface, #fff);box-shadow:0 10px 24px -12px var(--shadow, rgba(34,43,69,.14));cursor:pointer;font-family:Cairo,system-ui,sans-serif;transition:transform .2s} .ds-track:hover{transform:translateY(-2px)} .ds-track:focus-visible{outline:2px solid var(--accent, #2c7d59);outline-offset:2px} .ds-track-top{display:flex;align-items:center;justify-content:space-between} .ds-track-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:9999px;background:var(--accent-soft, #d8f0e3);color:var(--accent, #2c7d59)} .ds-track-tag{font-size:12px;font-weight:800;letter-spacing:.025em;color:var(--text-faint, #6b7280)} .ds-track-title{font-size:14px;font-weight:800;line-height:1.375;color:var(--text, #222b45)} .ds-track-bottom{display:flex;align-items:center;justify-content:space-between} .ds-track-dur{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--text-muted, #4b5263)} .ds-track-play{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9999px;background:var(--accent-soft, #d8f0e3);color:var(--accent, #2c7d59)"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Filter-Pille; aktiv = Salbeiminze-Füllung.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip is-on\">Alle</button><button class=\"ds-chip\">Schlaf</button><button class=\"ds-chip\">Emotionen</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;font-family:Cairo,system-ui,sans-serif} .ds-chip{padding:8px 16px;border:0;border-radius:9999px;background:var(--surface, #fff);color:var(--text-muted, #4b5263);font-size:12px;font-weight:700;box-shadow:0 4px 12px var(--shadow, rgba(34,43,69,.14));cursor:pointer;transition:background .2s} .ds-chip:focus-visible{outline:2px solid var(--accent, #2c7d59);outline-offset:2px} .ds-chip.is-on{background:var(--accent, #2c7d59);color:var(--accent-ink, #fff);box-shadow:none}"
    },
    {
      "name": "Suchleiste",
      "kind": "input",
      "refersTo": "search-bar",
      "description": "Vollpille auf Porzellan, überlappt das Banner.",
      "html": "<label class=\"ds-search\"><span class=\"ds-search-ic\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></span><input class=\"ds-search-in\" placeholder=\"Sound suchen …\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;width:320px;padding:12px 16px;border-radius:9999px;background:var(--surface, #fff);box-shadow:0 10px 26px var(--shadow, rgba(34,43,69,.14));font-family:Cairo,system-ui,sans-serif} .ds-search-ic{display:flex;color:var(--text-faint, #6b7280)} .ds-search-in{flex:1;border:0;outline:0;background:transparent;font:600 14px Cairo,system-ui,sans-serif;color:var(--text, #222b45)} .ds-search-in::placeholder{font-weight:500;color:var(--text-faint, #6b7280)}"
